"""Hyprland/Wayland desktop shell."""

module(
    name = "shell",
    version = "0.1.0",
)

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "toolchains_llvm", version = "1.9.1")

# Hermetic C toolchain: clang + lld downloaded by Bazel. rules_rust links
# through the registered cc toolchain, so no host compiler or linker is
# involved. glibc headers and libraries still come from the host (no sysroot
# is configured).
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    llvm_version = "23.1.1",
)
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

# Rust toolchain. The edition here is the default for every rust_* target.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.98.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Third-party crates, declared here and referenced as `@crates//:<name>`.
# Resolved versions are pinned in //third_party. After changing a spec run:
#   CARGO_BAZEL_REPIN=1 bazel mod deps
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    package = "anyhow",
    version = "1.0.104",
)
crate.spec(
    package = "env_logger",
    version = "0.11.11",
)
crate.spec(
    package = "log",
    version = "0.4.34",
)

# Wayland client stack (wlr-layer-shell). Default features are off and every
# feature is opted into explicitly. `calloop` provides the event loop.
# `system` selects the libwayland-client backend, required because Vulkan's
# Wayland WSI needs a real `wl_display *`. The `dlopen` feature below loads
# that library at runtime. `xkbcommon` translates key codes to keysyms and
# text. It links the host's libxkbcommon.so at build time, located by sctk's
# build script through the host pkg-config. Like glibc, it is one of the few
# host libraries the otherwise hermetic toolchain depends on.
crate.spec(
    default_features = False,
    features = [
        "calloop",
        "system",
        "xkbcommon",
    ],
    package = "smithay-client-toolkit",
    version = "0.21.1",
)
crate.spec(
    features = ["dlopen"],
    package = "wayland-client",
    version = "0.31.15",
)

# GPU rendering. Vulkan only, loaded at runtime through libvulkan.
crate.spec(
    default_features = False,
    features = [
        "std",
        "parking_lot",
        "vulkan",
        "wgsl",
    ],
    package = "wgpu",
    version = "30.0.1",
)
crate.spec(
    package = "raw-window-handle",
    version = "0.6.2",
)
crate.spec(
    package = "pollster",
    version = "1.0.1",
)

# UI.
crate.spec(
    package = "egui",
    version = "0.36.2",
)
crate.spec(
    default_features = False,
    package = "egui-wgpu",
    version = "0.36.2",
)

# Launcher: desktop entry parsing and fuzzy matching. The `gettext` feature
# of freedesktop-desktop-entry links a C library and is off. The rest of its
# dependency tree is pure Rust.
crate.spec(
    default_features = False,
    package = "freedesktop-desktop-entry",
    version = "0.8.3",
)
crate.spec(
    package = "nucleo-matcher",
    version = "0.3.1",
)

# Hyprland IPC replies (`//crates/hypr`).
crate.spec(
    package = "serde_json",
    version = "1.0.151",
)

# Configuration file.
crate.spec(
    features = ["derive"],
    package = "serde",
    version = "1.0.229",
)
crate.spec(
    package = "serde-saphyr",
    version = "1.3.0",
)
crate.from_specs(
    name = "crates",
    cargo_lockfile = "//third_party:crates.lock",
    lockfile = "//third_party:crates.bazel.lock",
)
use_repo(crate, "crates")
